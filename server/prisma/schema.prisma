generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector", schema: "public")]
}

// =============================================
// Enums
// =============================================

enum UserRole {
  STUDENT
  TUTOR
  REVIEWER
  ADMIN
  SUPER_ADMIN
}

enum ChapterStatus {
  LOCKED
  DRAFT
  IN_REVIEW
  APPROVED
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum AgentType {
  STRUCTURE
  METHODOLOGY
  COHERENCE
  CITATIONS
  FORMAT
  INTEGRITY
}

enum AgentStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ObservationSeverity {
  INFO
  SUGGESTION
  WARNING
  ERROR
}

enum KnowledgeLayer {
  TUTOR
  INSTITUTIONAL
  BIBLIOGRAPHY
}

enum ObservationSource {
  SYSTEM
  TUTOR
}

enum NotificationType {
  NEW_SUBMISSION
  REVIEW_COMPLETE
  CHAPTER_APPROVED
  CHAPTER_REJECTED
  INACTIVITY_ALERT
  ESCALATION_ALERT
}

enum AlertType {
  INACTIVITY
  ESCALATION
}

// =============================================
// Models
// =============================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(255)
  role         UserRole
  passwordHash String   @default("") @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  thesis               ThesisDocument?    @relation("StudentThesis")
  tutoredTheses        ThesisDocument[]   @relation("TutorTheses")
  approvedChapters     Chapter[]          @relation("ApprovedByTutor")
  submissions          Submission[]
  knowledgeChunks      KnowledgeChunk[]
  authoredObservations Observation[]      @relation("ObservationAuthor")
  studentAssignment    StudentAssignment? @relation("AssignedStudent")
  tutoredAssignments   StudentAssignment[] @relation("AssignedTutor")
  reviewedAssignments  StudentAssignment[] @relation("AssignedReviewer")
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@map("users")
}

model ThesisDocument {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(500)
  studentId String   @unique @map("student_id") @db.Uuid
  tutorId   String?  @map("tutor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  student  User      @relation("StudentThesis", fields: [studentId], references: [id])
  tutor    User?     @relation("TutorTheses", fields: [tutorId], references: [id])
  chapters Chapter[]
  alerts   Alert[]

  @@map("thesis_documents")
}

model Chapter {
  id         String        @id @default(uuid()) @db.Uuid
  number     Int           @db.SmallInt
  title      String        @db.VarChar(255)
  status     ChapterStatus @default(LOCKED)
  thesisId   String        @map("thesis_id") @db.Uuid
  approvedBy String?       @map("approved_by") @db.Uuid
  approvedAt DateTime?     @map("approved_at")
  comment    String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")

  // Relations
  thesis      ThesisDocument @relation(fields: [thesisId], references: [id])
  approver    User?          @relation("ApprovedByTutor", fields: [approvedBy], references: [id])
  submissions Submission[]

  @@unique([thesisId, number])
  @@map("chapters")
}

model Submission {
  id              String   @id @default(uuid()) @db.Uuid
  chapterId       String   @map("chapter_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  versionNumber   Int      @map("version_number")
  fileUrl         String   @map("file_url") @db.VarChar(500)
  fileName        String   @map("file_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  markdownContent String?  @map("markdown_content") @db.Text
  submittedAt     DateTime @default(now()) @map("submitted_at")

  // Relations
  chapter   Chapter    @relation(fields: [chapterId], references: [id])
  student   User       @relation(fields: [studentId], references: [id])
  reviewJob ReviewJob?

  @@unique([chapterId, versionNumber])
  @@index([studentId, submittedAt(sort: Desc)])
  @@map("submissions")
}

model ReviewJob {
  id           String    @id @default(uuid()) @db.Uuid
  submissionId String    @unique @map("submission_id") @db.Uuid
  status       JobStatus @default(QUEUED)
  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  durationMs   Int?      @map("duration_ms")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  submission   Submission   @relation(fields: [submissionId], references: [id])
  agentResults AgentResult[]
  reviewReport ReviewReport?

  @@map("review_jobs")
}

model AgentResult {
  id          String      @id @default(uuid()) @db.Uuid
  reviewJobId String      @map("review_job_id") @db.Uuid
  agentType   AgentType   @map("agent_type")
  status      AgentStatus @default(PENDING)
  findings    Json?
  startedAt   DateTime?   @map("started_at")
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  reviewJob    ReviewJob     @relation(fields: [reviewJobId], references: [id])
  observations Observation[]

  @@unique([reviewJobId, agentType])
  @@map("agent_results")
}

model ReviewReport {
  id                String   @id @default(uuid()) @db.Uuid
  reviewJobId       String   @unique @map("review_job_id") @db.Uuid
  summaryText       String   @map("summary_text") @db.Text
  totalObservations Int      @default(0) @map("total_observations")
  bySeverity        Json     @default("{}") @map("by_severity")
  generatedAt       DateTime @default(now()) @map("generated_at")

  // Relations
  reviewJob    ReviewJob     @relation(fields: [reviewJobId], references: [id])
  observations Observation[]

  @@map("review_reports")
}

model Observation {
  id              String              @id @default(uuid()) @db.Uuid
  agentResultId   String?             @map("agent_result_id") @db.Uuid
  reviewReportId  String              @map("review_report_id") @db.Uuid
  type            AgentType
  severity        ObservationSeverity
  message         String              @db.Text
  suggestion      String?             @db.Text
  textFragment    String?             @map("text_fragment") @db.Text
  offsetStart     Int?                @map("offset_start")
  offsetEnd       Int?                @map("offset_end")
  sourceReference Json?               @map("source_reference")
  createdAt       DateTime            @default(now()) @map("created_at")
  source          ObservationSource   @default(SYSTEM) @map("source")
  authorId        String?             @map("author_id") @db.Uuid
  isMutable       Boolean             @default(false) @map("is_mutable")
  escalationLevel Int                 @default(0) @map("escalation_level") @db.SmallInt

  // Relations
  agentResult  AgentResult?  @relation(fields: [agentResultId], references: [id])
  reviewReport ReviewReport @relation(fields: [reviewReportId], references: [id])
  author       User?        @relation("ObservationAuthor", fields: [authorId], references: [id])

  @@index([reviewReportId])
  @@index([agentResultId])
  @@map("observations")
}

model KnowledgeChunk {
  id             String         @id @default(uuid()) @db.Uuid
  layer          KnowledgeLayer
  ownerId        String?        @map("owner_id") @db.Uuid
  sourceDocument String         @map("source_document") @db.VarChar(255)
  sectionTitle   String?        @map("section_title") @db.VarChar(255)
  content        String         @db.Text
  embedding      Unsupported("vector(1536)")?
  chunkIndex     Int            @default(0) @map("chunk_index")
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  // Relations
  owner User? @relation(fields: [ownerId], references: [id])

  @@index([layer, ownerId])
  @@map("knowledge_chunks")
}

model StudentAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @unique @map("student_id") @db.Uuid
  tutorId    String   @map("tutor_id") @db.Uuid
  reviewerId String?  @map("reviewer_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  active     Boolean  @default(true)

  // Relations
  student  User  @relation("AssignedStudent", fields: [studentId], references: [id])
  tutor    User  @relation("AssignedTutor", fields: [tutorId], references: [id])
  reviewer User? @relation("AssignedReviewer", fields: [reviewerId], references: [id])

  @@index([tutorId])
  @@index([reviewerId])
  @@map("student_assignments")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String           @db.Text
  read      Boolean          @default(false)
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model Alert {
  id          String    @id @default(uuid()) @db.Uuid
  thesisId    String    @map("thesis_id") @db.Uuid
  type        AlertType
  triggeredAt DateTime  @default(now()) @map("triggered_at")
  resolvedAt  DateTime? @map("resolved_at")
  metadata    Json      @default("{}")

  // Relations
  thesis ThesisDocument @relation(fields: [thesisId], references: [id])

  @@index([thesisId, resolvedAt])
  @@map("alerts")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String   @db.VarChar(100)
  actorId    String   @map("actor_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
