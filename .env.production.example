# ===========================================
# THENA - Production Environment Variables
# ===========================================
# Usage:
#   cp .env.production.example .env
#   nano .env   ← fill in all CHANGE_ME values
#
# Generate strong secrets with:
#   openssl rand -base64 32
#
# Legend:
#   [MUST CHANGE]   — insecure placeholder, will break or be exploited if unchanged
#   [SAFE DEFAULT]  — works as-is in an isolated deployment; change for your environment
#   [FILL IN]       — required external credential, no default


# -------------------------------------------
# Database (PostgreSQL + pgvector)
# -------------------------------------------
# [SAFE DEFAULT] — internal Docker network, not exposed to host in prod
DATABASE_URL=postgresql://thena:CHANGE_ME_use_openssl_rand_base64_32@postgres:5432/thena

# -------------------------------------------
# Redis
# -------------------------------------------
# [SAFE DEFAULT] — internal Docker network, not exposed to host in prod
REDIS_URL=redis://redis:6379

# -------------------------------------------
# MinIO (S3-compatible object storage)
# -------------------------------------------
# [MUST CHANGE] — default credentials are public knowledge
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=thena
MINIO_SECRET_KEY=CHANGE_ME_use_openssl_rand_base64_32
MINIO_BUCKET=thena-documents
MINIO_USE_SSL=false

# -------------------------------------------
# CORS — allowed frontend origin
# -------------------------------------------
# [MUST CHANGE] — set to your production domain (e.g. https://thena.upb.edu)
# NestJS uses this to validate browser request origins.
# Engine uses this too (see CORS_ORIGIN in engine config).
CORS_ORIGIN=https://your-production-domain.example.com

# -------------------------------------------
# NestJS Server
# -------------------------------------------
# [SAFE DEFAULT]
NODE_ENV=production
PORT=3000

# -------------------------------------------
# JWT Authentication
# -------------------------------------------
# [MUST CHANGE] — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=CHANGE_ME_use_openssl_rand_base64_32
# [MUST CHANGE] — must be different from JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_use_openssl_rand_base64_32
# [SAFE DEFAULT] — short-lived access token
JWT_ACCESS_EXPIRY=15m
# [SAFE DEFAULT] — long-lived refresh token
JWT_REFRESH_EXPIRY=7d

# -------------------------------------------
# Inter-Service Auth (NestJS → Engine)
# -------------------------------------------
# [MUST CHANGE] — generate with: openssl rand -base64 32
# If left empty, the engine skips validation (INSECURE in production).
INTERNAL_API_KEY=CHANGE_ME_use_openssl_rand_base64_32

# -------------------------------------------
# Engine URL (NestJS calls this internally)
# -------------------------------------------
# [SAFE DEFAULT] — internal Docker network service name
ENGINE_URL=http://engine:8000

# -------------------------------------------
# LLM Configuration
# -------------------------------------------
# [SAFE DEFAULT] — change model based on your budget / quality requirements
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# -------------------------------------------
# Embedding Configuration
# -------------------------------------------
# [SAFE DEFAULT]
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# -------------------------------------------
# RAG Configuration
# -------------------------------------------
# [SAFE DEFAULT] — tune after observing retrieval quality
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TUTOR_WEIGHT=1.5

# -------------------------------------------
# API Keys (fill based on chosen LLM/embedding provider)
# -------------------------------------------
# [FILL IN] — required if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# [FILL IN] — required if LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini
GOOGLE_API_KEY=

# -------------------------------------------
# Client (Vite build-time env — baked into the static bundle)
# -------------------------------------------
# [MUST CHANGE] — must point to your production server's public URL
# This is used at build time by the React app (VITE_ prefix required).
VITE_API_URL=https://your-production-domain.example.com/api/v1
