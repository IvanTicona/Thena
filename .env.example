# ===========================================
# THENA - Variables de Entorno
# ===========================================
# Copiar este archivo a .env y completar los valores:
#   cp .env.example .env
#
# ⚠️  NUNCA commitear el archivo .env al repositorio.
# ⚠️  En producción, cambiar TODOS los valores marcados con [PRODUCCIÓN].
#
# Referencia completa: docs/ENV_VARS.md
# ===========================================


# -------------------------------------------
# BASE DE DATOS — PostgreSQL
# -------------------------------------------
# Cadena de conexión usada por Prisma (server) y SQLAlchemy (engine).
# DESARROLLO: apunta al contenedor postgres:5432
# PRODUCCIÓN: apuntar a pgbouncer:6432 para usar el pool de conexiones
DATABASE_URL=postgresql://thena:thena@postgres:5432/thena

# Credenciales de PostgreSQL (usadas por docker-compose y PgBouncer en prod)
# [PRODUCCIÓN] Cambiar por una contraseña segura y larga
POSTGRES_USER=thena
POSTGRES_PASSWORD=thena
POSTGRES_DB=thena


# -------------------------------------------
# REDIS — Cola de mensajes (BullMQ)
# -------------------------------------------
# DESARROLLO: sin contraseña
# PRODUCCIÓN: incluir contraseña en la URL: redis://:<REDIS_PASSWORD>@redis:6379
REDIS_URL=redis://redis:6379

# [PRODUCCIÓN] Contraseña de Redis. Redis corre con --requirepass en prod.
# Dejar vacío en desarrollo.
REDIS_PASSWORD=


# -------------------------------------------
# MINIO — Almacenamiento de objetos
# -------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# [PRODUCCIÓN] Cambiar por credenciales seguras
MINIO_ACCESS_KEY=thena
MINIO_SECRET_KEY=thena-secret
# Bucket para archivos DOCX de tesis
MINIO_BUCKET=thena-documents
# Usar SSL para conectarse a MinIO (false si Nginx ya termina SSL)
MINIO_USE_SSL=false
# Bucket para backups de base de datos (usado por backup-cron en prod)
MINIO_BACKUP_BUCKET=thena-backups


# -------------------------------------------
# SERVIDOR NESTJS
# -------------------------------------------
# [PRODUCCIÓN] Cambiar a: production
NODE_ENV=development
PORT=3000

# [PRODUCCIÓN] Cambiar al dominio HTTPS del cliente: https://thena.upb.edu.bo
CORS_ORIGIN=http://localhost:5173

# Dominio de producción (usado como referencia para Nginx y CORS)
# [PRODUCCIÓN] Completar con el dominio real
DOMAIN=thena.upb.edu.bo


# -------------------------------------------
# JWT — Autenticación
# -------------------------------------------
# [PRODUCCIÓN] Generar con: openssl rand -base64 64
# El servidor rechazará el arranque si estos valores son los de ejemplo
JWT_ACCESS_SECRET=your-access-secret-change-in-production
# [PRODUCCIÓN] Generar con: openssl rand -base64 64 (diferente al access secret)
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d


# -------------------------------------------
# COMUNICACIÓN INTERNA — Server ↔ Engine
# -------------------------------------------
# Clave compartida para autenticar llamadas internas entre NestJS y FastAPI.
# [PRODUCCIÓN] Usar una cadena aleatoria larga. En desarrollo puede quedar vacío.
INTERNAL_API_KEY=


# -------------------------------------------
# MOTOR DE IA (FastAPI Engine)
# -------------------------------------------
# URL del engine FastAPI (interna, dentro de la red Docker)
ENGINE_URL=http://engine:8000
ENGINE_PORT=8000


# -------------------------------------------
# CLAVES DE API — Proveedores LLM
# -------------------------------------------
# ⚠️  ADVERTENCIA: NUNCA commitear claves reales al repositorio.
# Reemplazar con la clave real en .env (que debe estar en .gitignore).

# OpenAI — requerida para los 6 agentes de revisión y embeddings
# [PRODUCCIÓN] Completar con clave real de OpenAI
OPENAI_API_KEY=sk-your-key-here

# Google Gemini — solo si LLM_PROVIDER=google
GOOGLE_API_KEY=


# -------------------------------------------
# CONFIGURACIÓN DEL MODELO LLM
# -------------------------------------------
# Proveedor: openai | google
LLM_PROVIDER=openai
# Modelo para los agentes de revisión
LLM_MODEL=gpt-4o-mini
# Temperatura: 0.0 = determinístico, 1.0 = creativo
# Para revisión académica se recomienda 0.1
LLM_TEMPERATURE=0.1


# -------------------------------------------
# CONFIGURACIÓN DE EMBEDDINGS
# -------------------------------------------
# Proveedor: openai | google
EMBEDDING_PROVIDER=openai
# Modelo de embeddings — dimensión: 1536 (fija en schema pgvector)
# ⚠️  Cambiar este modelo requiere re-generar todos los embeddings existentes
EMBEDDING_MODEL=text-embedding-3-small


# -------------------------------------------
# RAG — Retrieval-Augmented Generation
# -------------------------------------------
# Número máximo de chunks a recuperar por búsqueda de similitud
RAG_TOP_K=10
# Umbral mínimo de similitud coseno (0.0 a 1.0)
RAG_SIMILARITY_THRESHOLD=0.7
# Multiplicador de relevancia para chunks de la capa TUTOR
RAG_TUTOR_WEIGHT=1.5


# -------------------------------------------
# BACKUPS (usado por el servicio backup-cron en prod)
# -------------------------------------------
# Host de PostgreSQL para pg_dump (default: postgres)
POSTGRES_HOST=postgres
# Días de retención de backups en MinIO (default: 30)
BACKUP_RETENTION_DAYS=30
