# ===========================================
# THENA — Variables de Entorno
# ===========================================
# Copiar este archivo a .env y completar los valores:
#   cp .env.example .env
#
# NUNCA commitear el archivo .env al repositorio.
# En produccion, cambiar TODOS los valores marcados con [PRODUCCION].
# ===========================================


# -------------------------------------------
# PUERTOS — Docker host ports
# -------------------------------------------
# Todos los puertos son obligatorios. Sin valores por defecto.

# Servicios propios (mismo puerto dentro y fuera del container)
PORT_SERVER=3100
PORT_ENGINE=8000
PORT_CLIENT=5173

# Infraestructura (puerto host:puerto fijo interno)
PORT_POSTGRES=5432
PORT_REDIS=6379
PORT_MINIO_API=9000
PORT_MINIO_CONSOLE=9001

# Solo produccion (nginx)
PORT_HTTP=80
PORT_HTTPS=443


# -------------------------------------------
# BASE DE DATOS — PostgreSQL
# -------------------------------------------
# Cadena de conexion usada por Prisma (server) y SQLAlchemy (engine).
DATABASE_URL=postgresql://thena:thena@postgres:5432/thena

# Credenciales de PostgreSQL (usadas por docker-compose)
# [PRODUCCION] Cambiar por contrasena segura y larga
POSTGRES_USER=thena
POSTGRES_PASSWORD=thena
POSTGRES_DB=thena

# Host y puerto internos de PostgreSQL (usados por los scripts de backup/restore)
# Dentro de Docker, el host es el nombre del servicio y el puerto es siempre 5432
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Contrasena para pg_dump/pg_restore (debe coincidir con POSTGRES_PASSWORD)
PGPASSWORD=thena


# -------------------------------------------
# REDIS — Cola de mensajes (BullMQ)
# -------------------------------------------
# DESARROLLO: sin contrasena
# PRODUCCION: incluir contrasena en la URL: redis://:<REDIS_PASSWORD>@redis:6379
REDIS_URL=redis://redis:6379

# [PRODUCCION] Contrasena de Redis. Redis corre con --requirepass en prod.
# Dejar vacio en desarrollo.
REDIS_PASSWORD=


# -------------------------------------------
# MINIO — Almacenamiento de objetos
# -------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# [PRODUCCION] Cambiar por credenciales seguras
MINIO_ACCESS_KEY=thena
MINIO_SECRET_KEY=thena-secret
# Bucket para archivos DOCX de tesis
MINIO_BUCKET=thena-documents
# Usar SSL para conectarse a MinIO (false si Nginx ya termina SSL)
MINIO_USE_SSL=false

# URL completa del endpoint MinIO (usada por los scripts de backup/restore)
MINIO_ENDPOINT_URL=http://minio:9000
# Bucket para backups de base de datos (usado por backup-cron en prod)
MINIO_BACKUP_BUCKET=thena-backups
# Dias de retencion de backups en MinIO
BACKUP_RETENTION_DAYS=30


# -------------------------------------------
# SERVIDOR NESTJS
# -------------------------------------------
# [PRODUCCION] Cambiar a: production
NODE_ENV=development

# [PRODUCCION] Cambiar al dominio HTTPS del cliente: https://thena.skynetupb.store
CORS_ORIGIN=http://localhost:5173

# Dominio de produccion
DOMAIN=thena.skynetupb.store


# -------------------------------------------
# JWT — Autenticacion
# -------------------------------------------
# [PRODUCCION] Generar con: openssl rand -base64 64
# El servidor rechazara el arranque si estos valores son los de ejemplo
JWT_ACCESS_SECRET=your-access-secret-change-in-production
# [PRODUCCION] Generar con: openssl rand -base64 64 (diferente al access secret)
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d


# -------------------------------------------
# COMUNICACION INTERNA — Server <-> Engine
# -------------------------------------------
# Clave compartida para autenticar llamadas internas entre NestJS y FastAPI.
# [PRODUCCION] Usar una cadena aleatoria larga. En desarrollo puede quedar vacio.
INTERNAL_API_KEY=


# -------------------------------------------
# MOTOR DE IA (FastAPI Engine)
# -------------------------------------------
# URL del engine FastAPI (interna, dentro de la red Docker)
ENGINE_URL=http://engine:8000


# -------------------------------------------
# CLAVES DE API — Proveedores LLM
# -------------------------------------------
# ADVERTENCIA: NUNCA commitear claves reales al repositorio.

# OpenAI — requerida para los agentes de revision y embeddings
# [PRODUCCION] Completar con clave real de OpenAI
OPENAI_API_KEY=sk-your-key-here

# Google Gemini — solo si LLM_PROVIDER=google
GOOGLE_API_KEY=


# -------------------------------------------
# CONFIGURACION DEL MODELO LLM
# -------------------------------------------
# Proveedor: openai | google
LLM_PROVIDER=openai
# Modelo para los agentes de revision
LLM_MODEL=gpt-4o-mini
# Temperatura: 0.0 = deterministico, 1.0 = creativo
LLM_TEMPERATURE=0.1


# -------------------------------------------
# CONFIGURACION DE EMBEDDINGS
# -------------------------------------------
# Proveedor: openai | google
EMBEDDING_PROVIDER=openai
# Modelo de embeddings — dimension: 1536 (fija en schema pgvector)
# Cambiar este modelo requiere re-generar todos los embeddings existentes
EMBEDDING_MODEL=text-embedding-3-small


# -------------------------------------------
# RAG — Retrieval-Augmented Generation
# -------------------------------------------
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TUTOR_WEIGHT=1.5


# -------------------------------------------
# CLIENTE — Vite
# -------------------------------------------
# URL de la API del servidor (debe coincidir con PORT_SERVER)
VITE_API_URL=http://localhost:3100/api/v1
