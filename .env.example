# ===========================================
# THENA - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# Database
DATABASE_URL=postgresql://thena:thena@postgres:5432/thena

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=thena
MINIO_SECRET_KEY=thena-secret
MINIO_BUCKET=thena-documents
MINIO_USE_SSL=false

# CORS
CORS_ORIGIN=http://localhost:5173

# NestJS
PORT=3000

# AI Engine
ENGINE_URL=http://engine:8000

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# RAG Configuration
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TUTOR_WEIGHT=1.5

# API Keys (fill in based on your chosen provider)
OPENAI_API_KEY=
GOOGLE_API_KEY=
